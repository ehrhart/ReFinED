# Public port for the ReFinED service
REFINED_PORT=8458
# Docker memory limit for the container
MEM_LIMIT=32g
# Model: wikipedia_model, wikipedia_model_with_numbers, or a path to a fine-tuned model
MODEL_NAME=wikipedia_model
# Entity set backing the model: wikipedia | wikidata
ENTITY_SET=wikipedia
# Use precomputed entity description embeddings (recommended)
USE_PRECOMPUTED_DESCRIPTIONS=true
# cpu, or a cuda device such as cuda:0
REFINED_DEVICE=cpu
# uvicorn worker processes; each loads its own model
UVICORN_WORKERS=6
# torch intra-op threads per worker; workers x threads should stay <= host logical cores
TORCH_NUM_THREADS=4
# Top-k predicted entities returned per span
TOP_K_ENTITIES=5
